# Optional model provider: gemini, ollama, openai, or demo.
# Leave AI_PROVIDER empty to use Gemini when GEMINI_API_KEY is present; otherwise demo mode.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
DATABASE_URL=postgresql://prepwise:prepwise@localhost:5432/prepwise
PORT=8000
